# Database (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/CvAdvisorPlatform?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# HTTP and frontend
PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Email
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-with-an-app-password

# AI
CVADVISOR_OPENROUTER_API_KEY=replace-me

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Payment
# Use exactly the same value as Casso's secure_token.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
PAYMENT_SIMULATION_ENABLED=false
PAYMENT_BANK_ID=MB
PAYMENT_BANK_NAME=MB Bank
PAYMENT_ACCOUNT_NO=replace-me
PAYMENT_ACCOUNT_NAME=replace-me

# Persistent storage (use /app/data on a deployed volume)
FILE_UPLOAD_DIR=uploads
CV_PRIVATE_UPLOAD_DIR=private-uploads/cv
CV_APPLICATION_UPLOAD_DIR=private-uploads/applications
APP_SETTINGS_FILE=config/system_settings.json
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB

# Production volume example:
# FILE_UPLOAD_DIR=/app/data/uploads
# CV_PRIVATE_UPLOAD_DIR=/app/data/private-uploads/cv
# CV_APPLICATION_UPLOAD_DIR=/app/data/private-uploads/applications
# APP_SETTINGS_FILE=/app/data/config/system_settings.json
