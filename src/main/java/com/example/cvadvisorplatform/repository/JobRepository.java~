package com.example.cvadvisorplatform.repository;

import com.example.cvadvisorplatform.model.Job;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.Optional;

public interface JobRepository extends JpaRepository<Job, Long> {

    /* =====================================================
       ======================= HR ==========================
       ===================================================== */

    // Danh sách job của công ty – MỚI NHẤT LÊN ĐẦU
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.company.companyId = :companyId
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findJobsByCompanyNewestFirst(@Param("companyId") Long companyId);

    // Lấy 1 job theo company (không cần sort)
    Optional<Job> findByJobIdAndCompanyCompanyId(Long jobId, Long companyId);

    // Tìm theo tiêu đề – HR
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.company.companyId = :companyId
          AND LOWER(j.title) LIKE LOWER(CONCAT('%', :keyword, '%'))
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findByCompanyAndTitleNewestFirst(
            @Param("companyId") Long companyId,
            @Param("keyword") String keyword
    );

    // Lọc theo kinh nghiệm – HR
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.company.companyId = :companyId
          AND j.experienceLevel = :experienceLevel
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findByCompanyAndExperienceNewestFirst(
            @Param("companyId") Long companyId,
            @Param("experienceLevel") String experienceLevel
    );

    // Tìm + lọc – HR
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.company.companyId = :companyId
          AND LOWER(j.title) LIKE LOWER(CONCAT('%', :keyword, '%'))
          AND j.experienceLevel = :experienceLevel
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findByCompanyTitleAndExperienceNewestFirst(
            @Param("companyId") Long companyId,
            @Param("keyword") String keyword,
            @Param("experienceLevel") String experienceLevel
    );


    /* =====================================================
       ===================== PUBLIC ========================
       ===================================================== */

    // Danh sách job public – MỚI NHẤT LÊN ĐẦU
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.active = true
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findActiveJobsNewestFirst();

    // Search theo title – public
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.active = true
          AND LOWER(j.title) LIKE LOWER(CONCAT('%', :keyword, '%'))
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findActiveJobsByTitleNewestFirst(@Param("keyword") String keyword);

    // Search theo location – public
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.active = true
          AND LOWER(j.location) LIKE LOWER(CONCAT('%', :location, '%'))
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findActiveJobsByLocationNewestFirst(@Param("location") String location);

    // Search theo title + location – public
    @Query("""
        SELECT j
        FROM Job j
        WHERE j.active = true
          AND LOWER(j.title) LIKE LOWER(CONCAT('%', :keyword, '%'))
          AND LOWER(j.location) LIKE LOWER(CONCAT('%', :location, '%'))
        ORDER BY j.createdAt DESC, j.jobId DESC
    """)
    List<Job> findActiveJobsByTitleAndLocationNewestFirst(
            @Param("keyword") String keyword,
            @Param("location") String location
    );


    /* =====================================================
       ================= VIEW COUNT ========================
       ===================================================== */

    @Modifying
    @Transactional
    @Query("""
        UPDATE Job j
        SET j.viewCount = COALESCE(j.viewCount, 0) + 1
        WHERE j.jobId = :id
    """)
    void incrementViewCount(@Param("id") Long id);
}
