package com.example.cvadvisorplatform.controller;

import com.example.cvadvisorplatform.dto.AiCvEvaluationRequest;
import com.example.cvadvisorplatform.dto.AiCvEvaluationResponse;
import com.example.cvadvisorplatform.service.OpenRouterService;
import com.example.cvadvisorplatform.service.PdfTextExtractorService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.http.MediaType;
import org.springframework.web.multipart.MultipartFile;

import java.io.IOException;

@RestController
@RequestMapping("/api/v1/ai")
@CrossOrigin(origins = "*") // Update this to specific frontend URL in production
public class AiController {

    private final OpenRouterService openRouterService;
    private final PdfTextExtractorService pdfTextExtractorService;

    @Autowired
    public AiController(OpenRouterService openRouterService, PdfTextExtractorService pdfTextExtractorService) {
        this.openRouterService = openRouterService;
        this.pdfTextExtractorService = pdfTextExtractorService;
    }

//    @PostMapping("/evaluate-cv")
//    public ResponseEntity<AiCvEvaluationResponse> evaluateCv(@RequestBody AiCvEvaluationRequest request) {
//        // Here you can add security checks to ensure the user has permission to evaluate
//        AiCvEvaluationResponse response = openRouterService.evaluateCv(request);
//        return ResponseEntity.ok(response);
//    }
//


    @PostMapping(
            value = "/evaluate-cv",
            consumes = MediaType.MULTIPART_FORM_DATA_VALUE
    )
    public ResponseEntity<AiCvEvaluationResponse> evaluateCv(
            @RequestParam("cv") MultipartFile cvFile
    ) throws IOException {

        String cvText = pdfTextExtractorService.extractText(cvFile);

        AiCvEvaluationRequest request = new AiCvEvaluationRequest();
        request.setCvText(cvText);
        // nếu request cần thêm thông tin, set thêm ở đây

        AiCvEvaluationResponse response = openRouterService.evaluateCv(request);
        return ResponseEntity.ok(response);
    }
}
